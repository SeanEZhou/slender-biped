# Python / environments
.venv*/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# Secrets and local config (never commit)
.env
.env.*
*.pem
*.key
*.netrc
secrets*
credentials*
wandb/

# Training runs: keep configs and learning curves for every run, weights only for the
# selected policy (walk_A8_v6b_ft) and the checkpoint it was fine-tuned from.
runs/*
!runs/*/
runs/*/*
!runs/*/config.json
!runs/*/progress.jsonl
!runs/*/done.json
!runs/walk_A8_v6b_ft/params.pkl
!runs/walk_A8_v5_dr_s0/params_0030M.pkl
*.log
checkpoints/
*.zip

# Large media: README uses the GIFs in assets/gifs; mp4s are regenerated by scripts/render_rollout.py
assets/videos/
*.mp4

