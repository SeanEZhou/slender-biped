# Training runs: keep configs and learning curves for every run, weights only for selected policies
# and the checkpoints they were fine-tuned from.
runs/*
!runs/*/
runs/*/*
!runs/*/config.json
!runs/*/progress.jsonl
!runs/*/done.json
!runs/walk_A8_v6b_ft/params.pkl
!runs/walk_A8_v5_dr_s0/params_0030M.pkl
# round 2: best ball policy and its fine-tune chain, the pad standing and walking policies, footed controls
!runs/cadence_A8_ft/params_0020M.pkl
!runs/stride_A8_ft/params_0010M.pkl
!runs/q2_stand_P30/params_0022M.pkl
!runs/stride_P30_ft/params_0020M.pkl
!runs/ctl_stand_F60_12/params_0045M.pkl
# round 3 (as-built hardware model): best stand/walk policies, their fine-tune chains, the C046+60 mm reference
!runs/hw_stand_ft/params_0040M.pkl
!runs/hw_stand_push/params_0030M.pkl
!runs/hw_stand_push2/params_0020M.pkl
!runs/hw_walk_scratch/params_0081M.pkl
!runs/hw_walk_scratch_stride/params_0025M.pkl
!runs/hw_walk_scratch_stride2/params_0020M.pkl
!runs/hw_walk_best_push/params_0010M.pkl
!runs/hw_walk_c046s60_ft_s2/params_0012M.pkl
